# Copier ce fichier en .env et adapter les valeurs. Ne jamais committer .env.
# Sur le VPS : chmod 600 .env
#
# Toutes les variables ont une valeur par défaut, sauf les secrets. Une variable
# absente ou vide prend sa valeur par défaut.

# --- Données ----------------------------------------------------------------
# Dossier des données (fichiers bruts, état). Dans Docker, il est imposé à /data.
# TURF_DONNEES=data

# Niveau des journaux : DEBUG, INFO, WARNING.
# TURF_JOURNAL_NIVEAU=INFO

# --- Base PostgreSQL --------------------------------------------------------
# Mot de passe du compte « turf ». Il n'existe nulle part ailleurs : c'est à vous de
# le créer, une fois, à l'installation. PostgreSQL l'adopte à son premier démarrage
# et refuse de démarrer s'il est vide.
# Lettres et chiffres uniquement : il est repris dans l'adresse ci-dessous.
# Pour en produire un : openssl rand -hex 24
POSTGRES_PASSWORD=

# Adresse de la base, pour l'ingestion, l'application et les commandes migrate, parse,
# qualite, export, evaluate.
# Le collecteur n'en a pas besoin. En production, remplacer MOT_DE_PASSE par la
# valeur de POSTGRES_PASSWORD ; « postgres » est le nom du service Docker.
TURF_BASE_URL=postgresql+psycopg://turf:MOT_DE_PASSE@postgres:5432/turf

# Intervalle entre deux passes d'ingestion, en secondes. Une minute : les pronostics
# de H-30 et H-5 attendent les cotes que le collecteur vient de prendre.
# TURF_INGESTION_INTERVALLE_S=60

# --- Pronostics --------------------------------------------------------------
# Attente, après les instantanés H-30 et H-5, avant de pronostiquer (secondes).
# TURF_INFERENCE_DELAI_S=120

# --- Source PMU -------------------------------------------------------------
# Racine de l'API turfinfo (non documentée, peut changer sans préavis).
# TURF_PMU_URL_BASE=https://online.turfinfo.api.pmu.fr/rest/client/7

# Intervalle minimal entre deux requêtes, en secondes.
# Plancher imposé par le code : 1.0 (une valeur inférieure est ignorée).
# TURF_PMU_INTERVALLE_S=1.0

# En-tête User-Agent envoyé à la source. Rester identifiable et honnête.
# Défaut : ilomad-turf/<version> (usage personnel, faible debit)
# TURF_PMU_USER_AGENT=

# Délai maximal d'une requête, en secondes.
# TURF_PMU_DELAI_S=20

# Durée de la suspension quand la source refuse les requêtes (403, 429), en secondes.
# TURF_PMU_PAUSE_REFUS_S=3600

# --- Collecte ---------------------------------------------------------------
# Instantanés avant course, en minutes avant le départ prévu.
# TURF_COLLECTE_CRENEAUX_MIN=60,30,15,5,2

# Instantanés de suivi, en minutes après le départ prévu, pris tant que les cotes
# bougent encore. Laisser vide (TURF_COLLECTE_SUIVI_MIN=) pour désactiver.
# TURF_COLLECTE_SUIVI_MIN=1,3,5,7,9

# Fréquence de rechargement du programme du jour, en secondes.
# TURF_COLLECTE_RECHARGE_PROGRAMME_S=900

# Couverture minimale attendue des instantanés avant course (alerte en dessous).
# TURF_COUVERTURE_SEUIL=0.98

# --- Reprise d'historique (turf backfill) -----------------------------------
# Plage horaire pendant laquelle le collecteur rapatrie l'historique, heure de Paris.
# Laisser vide (TURF_REPRISE_PLAGE=) pour reprendre à toute heure : trois fois plus
# rapide, mais le serveur travaille aussi en journée.
# TURF_REPRISE_PLAGE=00:00-08:00

# --- Alertes Telegram -------------------------------------------------------
# Jeton du bot (donné par @BotFather) et identifiant de la discussion.
# Sans ces deux valeurs, les alertes ne vont que dans les journaux.
TURF_TELEGRAM_JETON=
TURF_TELEGRAM_DISCUSSION=

# --- Surveillance -----------------------------------------------------------
# Alerte si le collecteur ne donne plus signe de vie depuis N minutes.
# TURF_ALERTE_SILENCE_MIN=10

# Alerte si le disque dépasse ce taux d'occupation, en pourcentage.
# TURF_ALERTE_DISQUE_POURCENT=80

# --- Sauvegarde hors VPS (rclone) -------------------------------------------
# Destination au format rclone « distant:seau/dossier ». Vide : pas de sauvegarde,
# et un rappel quotidien par Telegram.
TURF_SAUVEGARDE_DESTINATION=

# Heure de la sauvegarde quotidienne, heure de Paris.
# TURF_SAUVEGARDE_HEURE=03:30

# Le distant rclone se déclare par variables RCLONE_CONFIG_<NOM>_*. Exemple pour un
# stockage compatible S3 nommé « turf », à utiliser avec
# TURF_SAUVEGARDE_DESTINATION=turf:nom-du-seau/ilomad-turf
# RCLONE_CONFIG_TURF_TYPE=s3
# RCLONE_CONFIG_TURF_PROVIDER=Other
# RCLONE_CONFIG_TURF_ENDPOINT=https://s3.fr-par.scw.cloud
# RCLONE_CONFIG_TURF_REGION=fr-par
# RCLONE_CONFIG_TURF_ACCESS_KEY_ID=
# RCLONE_CONFIG_TURF_SECRET_ACCESS_KEY=

# --- Spike du sprint 0 (scripts/spike_source_pmu.py) ------------------------
# Dossier de cache des réponses HTTP du spike.
# TURF_SPIKE_CACHE=data/spike-cache
